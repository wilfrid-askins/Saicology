<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
                                             android:layout_height="match_parent">

    <Button
            android:text="Book"
            android:layout_width="259dp"
            android:layout_height="76dp"
            android:id="@+id/bookButton" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="492dp" android:textSize="40sp" android:layout_marginEnd="380dp"
            android:layout_marginRight="380dp" tools:text="Book"/>
    <CalendarView
            android:layout_width="331dp"
            android:layout_height="224dp"
            android:id="@+id/calendarView" android:layout_marginTop="92dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="24dp" android:layout_marginStart="24dp"/>
    <TextView
            android:text="Total: £12.00"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/textView" android:textSize="40sp"
            android:layout_marginTop="500dp" app:layout_constraintTop_toTopOf="parent" android:layout_marginStart="24dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginLeft="24dp"/>
    <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="104dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginLeft="24dp"
            android:layout_marginStart="24dp" android:layout_marginTop="350dp"
            app:layout_constraintTop_toTopOf="parent">
        <RadioButton
                android:text="RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/radioButton4" android:layout_weight="1"
                tools:text="Daytime (7am-11pm)" android:textSize="32sp"/>
        <RadioButton
                android:text="RadioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/radioButton7" android:layout_weight="1"
                tools:text="Evening (11pm-7am)" android:textSize="32sp"/>
    </RadioGroup>
    <ImageView
            android:layout_width="521dp"
            android:layout_height="224dp" app:srcCompat="@drawable/map"
            android:id="@+id/imageView" android:layout_marginTop="92dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="36dp" android:layout_marginRight="36dp"/>
    <TextView
            android:text="Closest mechanic: 4 miles away"
            android:layout_width="396dp"
            android:layout_height="101dp"
            android:id="@+id/textView13" android:textSize="32sp "
            android:layout_marginTop="348dp" app:layout_constraintTop_toTopOf="parent" android:layout_marginEnd="108dp"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginRight="108dp"/>
</android.support.constraint.ConstraintLayout>