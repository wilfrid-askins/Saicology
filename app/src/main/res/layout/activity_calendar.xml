<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                             xmlns:app="http://schemas.android.com/apk/res-auto"
                                             xmlns:tools="http://schemas.android.com/tools"
                                             android:layout_width="match_parent"
                                             android:layout_height="match_parent"
                                             tools:context=".CalendarActivity">

    <Button
            android:text="Book"
            android:layout_width="313dp"
            android:layout_height="100dp"
            android:id="@+id/bookButton" app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="728dp" android:textSize="60sp" android:layout_marginEnd="484dp"
            android:layout_marginRight="484dp" tools:text="Book"/>
    <CalendarView
            android:layout_width="494dp"
            android:layout_height="281dp"
            android:id="@+id/calendarView" android:layout_marginTop="112dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"
            android:layout_marginLeft="68dp" android:layout_marginStart="68dp"/>
    <TextView
            android:text="Total: £35.00"
            android:layout_width="370dp"
            android:layout_height="95dp"
            android:id="@+id/textView" android:textSize="60sp "
            android:layout_marginTop="732dp" app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="88dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginLeft="88dp"/>
    <RadioGroup
            android:layout_width="wrap_content"
            android:layout_height="182dp"
            app:layout_constraintStart_toStartOf="parent" android:layout_marginLeft="24dp"
            android:layout_marginStart="24dp"
            tools:layout_editor_absoluteY="441dp">
        <RadioButton
                android:text="Daytime (7am-11pm)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/radioButton4" android:layout_weight="1"
                tools:text="Daytime (7am-11pm)" android:textSize="60sp "/>
        <RadioButton
                android:text="Evening (11pm-7am)"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:id="@+id/radioButton7" android:layout_weight="1"
                tools:text="Evening (11pm-7am)" android:textSize="60sp "/>
    </RadioGroup>
    <ImageView
            android:layout_width="562dp"
            android:layout_height="286dp" app:srcCompat="@drawable/map"
            android:id="@+id/imageView" android:layout_marginTop="120dp"
            app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="52dp" android:layout_marginRight="52dp"/>
    <TextView
            android:text="Closest mechanic: 4 miles away"
            android:layout_width="576dp"
            android:layout_height="166dp"
            android:id="@+id/textView13" android:textSize="60sp "
            android:layout_marginTop="448dp" app:layout_constraintTop_toTopOf="parent" android:layout_marginEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent" android:layout_marginRight="40dp"/>
</android.support.constraint.ConstraintLayout>